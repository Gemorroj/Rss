{
    "name": "gemorroj/rss",
    "description": "RSS 2.0 feeds generator and parser",
    "keywords": ["rss", "feed", "generator", "parser"],
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Gemorroj"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5||^13",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Rss\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rss\\Tests\\": "tests/"
        }
    }
}
